<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the one-off model download (pinned URL, hash-checked). The test itself runs offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep downloads and test runs going with the screen off (Samsung freezes background activities). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Do it" for alarms and timers: opens the Clock app with the details filled in. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- AI apps Hapuya can hand a command to, once the user allows it. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="com.deepseek.chat" />
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <!-- Test build: plain http is allowed only so an AI app on this phone (127.0.0.1) or
         a PC on the home network can be reached. The shipped app will limit this. -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- GPU backend for LiteRT-LM (optional on each phone). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />

        <!-- Exported only to adb: DUMP is held by the shell, never by ordinary apps. -->
        <service
            android:name=".RunService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device AI benchmark of a local model; test build only" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An AI app's answer shared back to Hapuya. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
